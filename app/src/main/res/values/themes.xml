<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.TaskFlow" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_indigo</item>
        <item name="colorPrimaryContainer">@color/primary_indigo_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorSurface">@color/bg_surface_slate</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_dark_navy</item>
        <item name="android:windowBackground">@color/bg_dark_navy</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark_navy</item>
        <item name="android:navigationBarColor">@color/bg_dark_navy</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
    </style>

    <!-- Legacy style alias to keep manifest/system happy if referenced -->
    <style name="Theme.MyApplication" parent="Theme.TaskFlow" />

    <!-- Rounded BottomSheet Dialog Theme -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/bg_surface_slate</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

    <!-- Primary Gradient Button Style -->
    <style name="Widget.TaskFlow.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_gradient</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.TaskFlow.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke_slate</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <!-- Text Input Layout Style -->
    <style name="Widget.TaskFlow.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_box_stroke_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/bg_surface_slate</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="errorTextColor">@color/status_danger_coral</item>
        <item name="boxStrokeErrorColor">@color/status_danger_coral</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.TaskFlow.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_surface_slate</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/stroke_slate</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
