<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_bottom_sheet">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_max="560dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical"
            android:padding="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_surface"
            android:backgroundTint="@color/stroke_slate" />

        <!-- Title Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_form_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/dialog_add_task_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_form_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/action_cancel" />
        </RelativeLayout>

        <!-- Task Title Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_task_title"
            style="@style/Widget.TaskFlow.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/task_title_hint"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:tag="task_form_title_input" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Task Description Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_task_desc"
            style="@style/Widget.TaskFlow.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="@string/task_desc_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_task_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                android:textColor="@color/text_primary"
                android:tag="task_form_desc_input" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Priority Label & ChipGroup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/task_priority_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_priority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority_low"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_low"
                android:textColor="@color/priority_low"
                app:chipBackgroundColor="@color/priority_low_bg"
                app:chipStrokeColor="@color/priority_low"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="10dp"
                android:tag="priority_low_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority_medium"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/priority_medium"
                android:textColor="@color/priority_medium"
                app:chipBackgroundColor="@color/priority_medium_bg"
                app:chipStrokeColor="@color/priority_medium"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="10dp"
                android:tag="priority_medium_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority_high"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_high"
                android:textColor="@color/priority_high"
                app:chipBackgroundColor="@color/priority_high_bg"
                app:chipStrokeColor="@color/priority_high"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="10dp"
                android:tag="priority_high_chip" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Due Date Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/task_due_date_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_select_due_date"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/stroke_slate"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/bg_surface_slate"
            android:tag="task_form_due_date_card">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/iv_date_picker_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/accent_cyan"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_selected_due_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iv_date_picker_icon"
                    android:layout_toStartOf="@+id/btn_clear_due_date"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:text="@string/select_due_date"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:tag="task_form_due_date_text" />

                <ImageButton
                    android:id="@+id/btn_clear_due_date"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_muted"
                    android:visibility="gone"
                    android:contentDescription="@string/cd_clear_date"
                    tools:visibility="visible" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Task Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_task"
            style="@style/Widget.TaskFlow.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:text="@string/action_save_task"
            android:tag="task_form_save_button" />

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_task"
            style="@style/Widget.TaskFlow.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/action_cancel"
            android:tag="task_form_cancel_button" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
